# ---- Odoo credentials (kept on the server, never sent to Claude) ----------
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-db-name
ODOO_USER=you@company.com
ODOO_PASSWORD=your-odoo-api-key
# Set to 1 to block create/write/unlink/import/execute_kw from this deployment.
ODOO_READONLY=0

# ---- Transport -------------------------------------------------------------
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# The public https origin claude.ai will reach. Required for OAuth modes.
MCP_PUBLIC_URL=https://odoo-mcp.example.com

# ---- Auth ------------------------------------------------------------------
# none | token | github | google | auth0 | workos | jwt
MCP_AUTH=github

# Who may use the tools once logged in. Comma-separated; matched against the
# user's email, login or subject. REQUIRED in practice for github/google —
# without it, anyone with an account at that provider can log in.
MCP_ALLOWED_USERS=your-github-login,you@company.com

# github / google / auth0 / workos
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# auth0 only
AUTH0_CONFIG_URL=https://YOUR_TENANT.auth0.com/.well-known/openid-configuration
AUTH0_AUDIENCE=https://odoo-mcp.example.com
# workos only
WORKOS_AUTHKIT_DOMAIN=https://YOUR_SUBDOMAIN.authkit.app
# jwt only (tokens minted by your own IdP)
JWT_JWKS_URI=
JWT_ISSUER=
JWT_AUDIENCE=

# token mode only — static bearer tokens for Claude Code / curl (not claude.ai)
MCP_BEARER_TOKENS=

# Only for local testing with MCP_AUTH=none
# MCP_ALLOW_UNAUTHENTICATED=1
