# Odoo MCP Multi on Vercel (container image). Vercel auto-detects this file,
# builds it, and routes all traffic to the container. Configure everything via
# the project's environment variables (see .env.example, "odoo" auth mode).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MCP_TRANSPORT=http \
    MCP_HOST=0.0.0.0 \
    PORT=80

WORKDIR /app
COPY pyproject.toml README.md server.py odoo_auth.py ./
RUN pip install --no-cache-dir ".[remote]"

RUN useradd --create-home --uid 1000 mcp
USER mcp

EXPOSE 80
CMD ["odoo-mcp"]
